# cmake -DOUT=<header> -DSTAMP=<stamp> -DFILES=<a;b;...> -P sim_hash.cmake
#
# Writes BROFLORA_SIM_HASH, a hash of the source of everything a step()
# computes with, into <header> (only when it changed, so nothing recompiles
# for a rebuild that left the step alone) and touches <stamp>. growCached
# keys its cache on it: a change to the step's source is a different grower,
# whose plants the cache must not hand back.

set(_all "")
foreach(_f IN LISTS FILES)
    file(SHA256 "${_f}" _h)
    get_filename_component(_n "${_f}" NAME)
    string(APPEND _all "${_n}:${_h}\n")
endforeach()
string(SHA256 _sum "${_all}")
string(SUBSTRING "${_sum}" 0 16 _short)

set(_text "// Generated by cmake/sim_hash.cmake: the hash of the step's source.\n#pragma once\n#define BROFLORA_SIM_HASH \"${_short}\"\n")
set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
    file(WRITE "${OUT}" "${_text}")
endif()
file(TOUCH "${STAMP}")
